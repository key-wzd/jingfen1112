# Copy server/.env.example to server/.env.local and set credentials.
TC_DB_HOST=localhost
TC_DB_PORT=3306
TC_DB_USER=root
TC_DB_PASSWORD=
TC_DB_NAME=techcompare_internal_copy
TC_API_PORT=3002
TC_API_HOST=127.0.0.1
# For a production deployment set NODE_ENV=production and both account passwords.
# TC_ADMIN_USER=admin
# TC_ADMIN_PASSWORD=
# TC_ANALYST_USER=user
# TC_ANALYST_PASSWORD=
# Additional individual accounts can be configured in server/accounts.local.json.
# See server/accounts.local.example.json; keep this file private and restart the API after editing.
# TC_AUTH_ACCOUNTS_FILE=C:/absolute/path/to/accounts.local.json
